# =============================================================
# Vercel Postgres (provision from Vercel Dashboard -> Storage ->
# Postgres / Neon, then paste the connection string below)
# =============================================================
DATABASE_URL=postgresql://USER:PASS@db.viektech-pool.vercel.io:5432/viektech?sslmode=require

# =============================================================
# Paystack (https://dashboard.paystack.co)
#  - Secret Key (sk_live_ or sk_test_)
#  - Public Key (pk_live_ or pk_test_) — safe to expose to client
#  - Webhook secret is derived from the same secret key
# =============================================================
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# =============================================================
# Moodle LMS
#  - MOODLE_URL: base URL of your Moodle instance (e.g. https://lms.viektech.com)
#  - MOODLE_TOKEN: REST API token (Site Admin -> Plugins -> Web Services ->
#                  Manage tokens -> Create token for a service-enabled user)
#  - MOODLE_STUDENT_ROLE_ID: default 5 (default Moodle "student" role)
#  - MOODLE_THEME: theme folder name to assign new students (e.g. "viek").
#                  Requires the web service to expose
#                  core_user_set_user_preferences and the site setting
#                  "Allow user themes" (Site Admin -> Theme -> Allow user themes).
#                  Omit to skip per-user theme assignment.
# =============================================================
MOODLE_URL=https://lms.viektech.com
MOODLE_TOKEN=your_moodle_web_service_token
MOODLE_STUDENT_ROLE_ID=5
MOODLE_THEME=viek
# Public mirror of MOODLE_URL so the success page can link to the LMS.
NEXT_PUBLIC_MOODLE_URL=https://lms.viektech.com

# =============================================================
# Email (welcome + credentials) via Resend (https://resend.com)
# Omit RESEND_API_KEY to skip email delivery (students will still
# receive password-reset instructions on the success page).
# =============================================================
RESEND_API_KEY=re_...
RESEND_FROM=Academy <onboarding@viektech.com>

# =============================================================
# Auth (NextAuth.js)
# Generate with: openssl rand -base64 32
# =============================================================
AUTH_SECRET=your-secret-key-here
